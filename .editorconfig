# EditorConfig — https://editorconfig.org
# Keeps indentation and whitespace consistent across editors. Rust formatting
# is still owned by `cargo fmt`; this just covers what rustfmt does not.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Rust: rustfmt's defaults (4-space, 100-col). `cargo fmt` is authoritative.
[*.rs]
indent_size = 4
max_line_length = 100

# Web client, config, and docs use 2-space indentation.
[*.{ts,js,html,css,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown; don't strip them.
trim_trailing_whitespace = false

[*.toml]
indent_size = 4
