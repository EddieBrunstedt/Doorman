#!/bin/sh
# Ensures staged files are dprint-formatted before a commit lands
# (Markdown, JSON, TOML, YAML — see dprint.json), and staged Rust passes
# rustfmt and clippy (the fast half of `just verify`).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass for one commit:   git commit --no-verify
set -eu

rust=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
if [ -n "$rust" ]; then
	just fmt-check
	just clippy
fi

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' '*.json' '*.toml' '*.yaml' '*.yml')
[ -z "$staged" ] && exit 0

if ! command -v dprint >/dev/null 2>&1; then
	echo "pre-commit: dprint not installed. Install it (cargo install dprint, or" >&2
	echo "https://dprint.dev/install) or commit with --no-verify to skip." >&2
	exit 1
fi

if ! echo "$staged" | xargs dprint check; then
	echo "pre-commit: files are not formatted. Run 'dprint fmt' and re-stage." >&2
	exit 1
fi
